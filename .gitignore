# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Deployment is handled by Dispatch's control plane, not Kamal. These
# auto-generated files are not part of the template.
/.kamal/
/config/deploy.yml

# config/master.key is intentionally committed so the template's own CI can pass
# and so forked apps start with a working key. Dispatch sets RAILS_MASTER_KEY as a
# repo secret at fork time; the deploy workflow overwrites the committed key before
# every build. All v1 apps share this key — see README for the security implications.


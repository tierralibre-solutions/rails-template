<% content_for :title, app_name %>

<div class="onboarding-page">
  <header class="onboarding-header">
    <h1 class="onboarding-title anim" style="--step: 0">
      <%= app_name %> is live.
    </h1>
    <p class="onboarding-sub anim" style="--step: 1">Here's what to do next.</p>
  </header>

  <ol class="steps">
    <li class="step anim" style="--step: 2">
      <span class="step-number">1</span>
      <div class="step-body">
        <h2 class="step-title">Open the Work tab</h2>
        <p class="step-desc">It's built into your Dispatch dashboard — no local setup needed.</p>
      </div>
    </li>

    <li class="step anim" style="--step: 3">
      <span class="step-number">2</span>
      <div class="step-body">
        <h2 class="step-title">Add a to-do</h2>
        <p class="step-desc">Describe what you want to build or fix.</p>
        <pre class="step-code">What do you want to build?</pre>
      </div>
    </li>

    <li class="step anim" style="--step: 4">
      <span class="step-number">3</span>
      <div class="step-body">
        <h2 class="step-title">Start an Agent Session</h2>
        <p class="step-desc">Claude works directly in your repo and commits the changes.</p>
      </div>
    </li>

    <li class="step anim" style="--step: 5">
      <span class="step-number">4</span>
      <div class="step-body">
        <h2 class="step-title">Watch it ship</h2>
        <p class="step-desc">Every change auto-deploys to your live URL in minutes.</p>
      </div>
    </li>
  </ol>

  <footer class="onboarding-footer anim" style="--step: 6">
    <p>Powered by <a href="https://dispatch.freeland.tools" target="_blank" rel="noopener" class="footer-link">Dispatch</a> — spin up, build, and ship Rails apps without leaving your browser.</p>
  </footer>
</div>
